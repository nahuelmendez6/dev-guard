# Configuración agnóstica del LLM
# Opciones soportadas: "google", "openai", "groq"
LLM_PROVIDER="google"
LLM_MODEL="gemini-2.5-flash"
LLM_TEMPERATURE="0.0"

# Claves de API (solo necesitas rellenar la del proveedor que elijas arriba)
GOOGLE_API_KEY="tu_clave_google_aqui"
OPENAI_API_KEY="tu_clave_openai_aqui"
GROQ_API_KEY="tu_clave_groq_aqui"
